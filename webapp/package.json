{
  "name": "webapp",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "dev": "astro dev",
    "dev:mock": "astro dev --mode mock",
    "mock": "aimock --config mock/aimock.json --port 4010",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "seed": "tsx scripts/seed-quests.ts",
    "dev:backend": "tsx aws-blocks/scripts/server.ts",
    "dev:blocks-mock": "astro dev --mode blocks-mock --background",
    "typecheck": "tsc --noEmit",
    "synth": "cdk synth --quiet",
    "deploy:agent": "cdk deploy QuestBoardAgent --exclusively --outputs-file blocks-outputs.json",
    "deploy:batch": "cdk deploy QuestBoardBatch --exclusively --outputs-file blocks-outputs.json",
    "deploy:web": "cdk deploy QuestBoardWeb --exclusively --outputs-file blocks-outputs.json"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.59",
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^7.0.0",
    "@aws-blocks/blocks": "0.8.0",
    "@aws-blocks/hosting": "0.4.1",
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-dynamodb": "^3.1141.0",
    "@aws-sdk/credential-providers": "^3.1140.0",
    "@aws-sdk/lib-dynamodb": "^3.1141.0",
    "@base-ui/react": "^1.8.0",
    "@copilotkit/a2ui-renderer": "^1.73.3",
    "@copilotkit/react-core": "^1.73.3",
    "@copilotkit/runtime": "^1.73.3",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.5",
    "aws-jwt-verify": "^5.2.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zod-to-json-schema": "^3.25.2"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@copilotkit/aimock": "^1.43.0",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "aws-cdk": "^2.1138.0",
    "aws-cdk-lib": "^2.257.0",
    "constructs": "^10.6.0",
    "esbuild": "^0.28.2",
    "@types/node": "^24.0.0"
  }
}
