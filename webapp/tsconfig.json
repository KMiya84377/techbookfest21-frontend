{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*",
    "../chat-agent/infra/**/*.ts",
    "../batch-agent/infra/**/*.ts"
  ],
  "exclude": [
    "dist",
    "cdk.out",
    ".cdk-blocks"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "aws-cdk-lib": [
        "./node_modules/aws-cdk-lib"
      ],
      "aws-cdk-lib/*": [
        "./node_modules/aws-cdk-lib/*"
      ]
    }
  }
}
